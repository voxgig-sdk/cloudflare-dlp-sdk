      h: "Ocr Enabled"
      n: "ocr_enabled"
      r: false
      t: "`$BOOLEAN`"
    }
    result: {
      h: "Result"
      n: "result"
      r: false
      t: "`$ANY`"
      union: {
        branches: 7
        count: 11
        depth: 15
      }
    }
    sensitivity_levels: {
      h: "Sensitivity Levels"
      n: "sensitivity_levels"
      r: false
      sh: "Sensitivity levels to associate with the profile."
      t: "`$ARRAY`"
    }
    shared_entries: {
      h: "Shared Entries"
      n: "shared_entries"
      r: false
