      t: "`$STRING`"
    }
    entries: {
      de: true
      h: "Entries"
      n: "entries"
      r: false
      sh: "Custom entries from this profile."
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
