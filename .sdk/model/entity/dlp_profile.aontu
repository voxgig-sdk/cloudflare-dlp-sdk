# Entity: dlp_profile

main: kit: entity: dlp_profile: {

  alias: field: {}

  fields: {
    ai_context_enabled: {
      h: "Ai Context Enabled"
      n: "ai_context_enabled"
      r: false
      t: "`$BOOLEAN`"
    }
    allowed_match_count: {
      fo: "int32"
      h: "Allowed Match Count"
      n: "allowed_match_count"
      r: false
      sh: "Related DLP policies will trigger when the match count exceeds the number set."
      t: "`$INTEGER`"
    }
    confidence_threshold: {
      h: "Confidence Threshold"
      n: "confidence_threshold"
      r: false
      t: "`$STRING`"
    }
    context_awareness: {
      de: true
      h: "Context Awareness"
      n: "context_awareness"
      r: true
      sh: "Scan the context of predefined entries to only return matches surrounded by keywords."
      t: "`$OBJECT`"
    }
    data_classes: {
      h: "Data Classes"
      n: "data_classes"
      r: false
      sh: "Data class IDs to associate with the profile."
