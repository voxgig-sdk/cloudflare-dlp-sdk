# Entity: dlp_predefined_entry

main: kit: entity: dlp_predefined_entry: {

  alias: field: {}

  fields: {
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      t: "`$BOOLEAN`"
    }
    entry_id: {
      fo: "uuid"
      h: "Entry Id"
      n: "entry_id"
      r: true
      t: "`$STRING`"
    }
    profile_id: {
      fo: "uuid"
      h: "Profile Id"
      n: "profile_id"
      r: false
      sh: "This field is not used as the owning profile."
      t: "`$STRING`"
    }
  }

  name: "dlp_predefined_entry"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /accounts/{account_id}/dlp/entries/predefined"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "account_id"
                or: "account_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/accounts/{account_id}/dlp/entries/predefined"
          q: {
            exist: [
              "account_id"
            ]
          }
          s: [
            {
              lit: "accounts"
            }
            {
              var: "account_id"
            }
            {
              lit: "dlp"
            }
            {
              lit: "entries"
            }
            {
              lit: "predefined"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /accounts/{account_id}/dlp/entries/predefined/{entry_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "account_id"
                or: "account_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "entry_id"
                or: "entry_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/accounts/{account_id}/dlp/entries/predefined/{entry_id}"
          q: {
            exist: [
              "account_id"
              "entry_id"
            ]
          }
          s: [
            {
              lit: "accounts"
            }
            {
              var: "account_id"
            }
            {
              lit: "dlp"
            }
            {
              lit: "entries"
            }
            {
              lit: "predefined"
            }
            {
              var: "entry_id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
