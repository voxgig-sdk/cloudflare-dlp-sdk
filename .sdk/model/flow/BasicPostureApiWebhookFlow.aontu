# BasicPostureApiWebhookFlow

main: kit: flow: BasicPostureApiWebhookFlow:
{
  entity: "posture_api_webhook",
  kind: "basic",
  name: "BasicPostureApiWebhookFlow",
  step: [
    {
      i: {
        ref: "posture_api_webhook_ref01"
      }

      m: {
        account_id: "account01",
        webhook_id: "webhook01"
      }

      o: "create"
    }

    {
      i: {
        ref: "posture_api_webhook_ref01",
        srcdatavar: "posture_api_webhook_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "posture_api_webhook01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-posture_api_webhook_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPostureApiWebhookFlow"
}