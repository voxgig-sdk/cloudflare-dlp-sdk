# BasicDlpEmailFlow

main: kit: flow: BasicDlpEmailFlow:
{
  entity: "dlp_email",
  kind: "basic",
  name: "BasicDlpEmailFlow",
  step: [
    {
      i: {
        ref: "dlp_email_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "dlp_email_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "dlp_email_ref01",
        srcdatavar: "dlp_email_ref01_data",
        suffix: "_up0",
        textfield: "description"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dlp_email_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "dlp_email_ref01",
        srcdatavar: "dlp_email_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "dlp_email01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dlp_email_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "dlp_email_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "dlp_email01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "dlp_email_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDlpEmailFlow"
}