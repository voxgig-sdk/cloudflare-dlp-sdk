# BasicPostureApiFindingInstanceFlow

main: kit: flow: BasicPostureApiFindingInstanceFlow:
{
  entity: "posture_api_finding_instance",
  kind: "basic",
  name: "BasicPostureApiFindingInstanceFlow",
  step: [
    {
      i: {
        ref: "posture_api_finding_instance_ref01"
      }

      m: {
        account_id: "account01",
        finding_id: "finding01"
      }

      o: "create"
    }

    {
      i: {
        ref: "posture_api_finding_instance_ref01",
        srcdatavar: "posture_api_finding_instance_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        finding_id: "finding01",
        id: "posture_api_finding_instance01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-posture_api_finding_instance_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPostureApiFindingInstanceFlow"
}