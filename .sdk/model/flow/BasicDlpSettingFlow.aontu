# BasicDlpSettingFlow

main: kit: flow: BasicDlpSettingFlow:
{
  entity: "dlp_setting",
  kind: "basic",
  name: "BasicDlpSettingFlow",
  step: [
    {
      i: {
        ref: "dlp_setting_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      i: {
        ref: "dlp_setting_ref01",
        srcdatavar: "dlp_setting_ref01_data",
        suffix: "_up0",
        textfield: "public_key"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dlp_setting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "dlp_setting_ref01",
        srcdatavar: "dlp_setting_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "dlp_setting01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-dlp_setting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "dlp_setting_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "dlp_setting01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicDlpSettingFlow"
}