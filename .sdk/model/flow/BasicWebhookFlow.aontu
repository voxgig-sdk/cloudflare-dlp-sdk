# BasicWebhookFlow

main: kit: flow: BasicWebhookFlow:
{
  entity: "webhook",
  kind: "basic",
  name: "BasicWebhookFlow",
  step: [
    {
      i: {
        ref: "webhook_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "webhook_ref01",
        srcdatavar: "webhook_ref01_data",
        suffix: "_up0",
        textfield: "authentication_type"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-webhook_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "webhook_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "webhook01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicWebhookFlow"
}